{
  "name": "@s8a-uk/astro-loader-asciidoc",
  "version": "0.1.0",
  "description": "AsciiDoc content loader for Astro 7, powered by Asciidoctor.js",
  "license": "MIT",
  "author": "s8a-uk",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "withastro",
    "astro-loader",
    "astro",
    "asciidoc",
    "asciidoctor",
    "content-collections"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s8a-uk/astro-loader-asciidoc.git"
  },
  "homepage": "https://github.com/s8a-uk/astro-loader-asciidoc#readme",
  "bugs": {
    "url": "https://github.com/s8a-uk/astro-loader-asciidoc/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "smoke": "node test/smoke/smoke.mjs",
    "test": "vitest run --project unit",
    "e2e": "vitest run --project e2e",
    "test:dev": "vitest run --project dev",
    "test:pack": "vitest run --project pack",
    "prepack": "rm -rf dist && npm run build"
  },
  "dependencies": {
    "@asciidoctor/core": "^4.2.1",
    "picomatch": "^4.0.7",
    "tinyglobby": "^0.2.17"
  },
  "peerDependencies": {
    "astro": "^7.4.0",
    "shiki": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "astro": "^7.4.12",
    "shiki": "^4.6.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
